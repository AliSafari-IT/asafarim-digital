{
  "name": "asafarim-digital",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "dev:portal": "turbo dev --filter=portal",
    "dev:ops": "turbo dev --filter=ops-hub",
    "onVPS:dockerRestart": "docker compose up -d --force-recreate portal content-generator ops-hub marketing-content edumatch",
    "db:generate": "pnpm --filter @asafarim/db prisma generate",
    "db:migrate": "pnpm --filter @asafarim/db prisma migrate dev",
    "db:studio": "pnpm --filter @asafarim/db prisma studio",
    "db:push": "pnpm --filter @asafarim/db prisma db push",
    "db:reset": "pnpm --filter @asafarim/db prisma db reset",
    "build:apk": "pnpm --filter mobile build:apk",
    "mobile:dev": "pnpm --filter mobile-next dev",
    "build:release": "pnpm --filter mobile build:release",
    "mobile-next:dev": "pnpm --filter mobile-next dev",
    "deviceID": "pnpm --dir apps/mobile-next exec cap run android --list",
    "deviceId": "pnpm --dir apps/mobile-next exec cap run android --list",
    "device:id": "pnpm --dir apps/mobile-next exec cap run android --list",
    "rs": "pnpm onVPS:dockerRestart",
    "onVPS:dockerDown": "docker compose down",
    "seed": "turbo seed"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AliSafari-IT/asafarim-digital.git"
  },
  "dependencies": {
    "dataconnect-generated": "link:../../../Users/saal/AppData/Local/pnpm/global/5/node_modules/src/dataconnect-generated"
  }
}
