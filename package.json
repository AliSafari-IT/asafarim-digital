{
  "name": "asafarim-digital",
  "version": "1.5.1",
  "private": true,
  "scripts": {
    "sh": "bash start.sh",
    "ps1": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "start": "pnpm ps1 start",
    "stop": "pnpm ps1 stop",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "git:reset": "git fetch --all && git reset --hard origin/main",
    "dev:portal": "turbo dev --filter=portal",
    "dev:ops": "turbo dev --filter=ops-hub",
    "dev:vionto": "turbo dev --filter=vionto",
    "dev:vionto:worker": "pnpm --dir apps/vionto worker:dev",
    "onVPS:prune": "cd /var/repos/asafarim-digital && docker system prune -af --volumes && docker builder prune -af",
    "onVPS:cleanup": "cd /var/repos/asafarim-digital && ./scripts/vps-cleanup.sh",
    "onVPS:cleanup:dry": "cd /var/repos/asafarim-digital && ./scripts/vps-cleanup.sh --dry-run",
    "onVPS:fixWorker": "cd /var/repos/asafarim-digital && ./scripts/fix-vionto-worker.sh",
    "onVPS:quickFixWorker": "cd /var/repos/asafarim-digital && ./scripts/quick-worker-fix.sh",
    "onVPS:dockerRestart": "docker compose up -d --force-recreate portal content-generator ops-hub marketing-content edumatch vionto vionto-worker",
    "onVPS:dockerPrune": "sh scripts/docker-post-deploy-prune.sh",
    "onVPS:deployPortal": "docker compose up -d --build portal && sh scripts/docker-post-deploy-prune.sh",
    "onVPS:deployVionto": "docker compose up -d --build vionto vionto-worker && sh scripts/docker-post-deploy-prune.sh",
    "onVPS:deployEdumatch": "docker compose up -d --build edumatch && sh scripts/docker-post-deploy-prune.sh",
    "db:generate": "pnpm --filter @asafarim/db prisma generate",
    "db:migrate": "pnpm --filter @asafarim/db prisma migrate dev",
    "db:migrate:deploy": "npx dotenv-cli -e .env -- pnpm --filter @asafarim/db exec prisma migrate deploy",
    "db:gen": "pnpm db:generate && pnpm db:migrate:deploy",
    "db:studio": "pnpm --filter @asafarim/db prisma studio",
    "db:push": "pnpm --filter @asafarim/db prisma db push",
    "db:reset": "pnpm --filter @asafarim/db prisma db reset",
    "rs": "pnpm onVPS:cleanup && pnpm onVPS:dockerRestart",
    "tc": "pnpm typecheck",
    "db": "docker compose up -d postgres",
    "onVPS:dockerDown": "docker compose down",
    "seed": "turbo seed",
    "redis": "docker compose ps redis",
    "onDev:cleanup": "powershell -ExecutionPolicy Bypass -File scripts/dev-cleanup.ps1",
    "envageEncrypt": "npx envage encrypt --all --env root",
    "envageDecrypt": "npx envage decrypt --all --env root"
  },
  "devDependencies": {
    "@smithy/types": "^4.14.1",
    "kill-port": "^2.0.1",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AliSafari-IT/asafarim-digital.git"
  },
  "dependencies": {
    "@asafarim/envage": "^0.3.3",
    "secure-env": "^1.2.0"
  }
}
