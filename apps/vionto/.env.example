NEXT_PUBLIC_VIONTO_URL=http://localhost:3006
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000

# Auth (shared with portal — same AUTH_SECRET for cross-subdomain SSO)
AUTH_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_URL=http://localhost:3006
AUTH_TRUST_HOST=true
DATABASE_URL=

# Vionto production integrations
REDIS_URL=redis://localhost:6379
# Use "local" for browser-to-server in-memory uploads during development.
# Leave empty or set "spaces" to use DigitalOcean Spaces.
VIONTO_STORAGE_DRIVER=local
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_PUBLIC_URL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
WORKER_HEALTH_PORT=3007
