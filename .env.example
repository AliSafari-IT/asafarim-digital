# â”€â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_USER=asafarim
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=asafarim
DATABASE_URL=postgresql://asafarim:change_me_in_production@localhost:55432/asafarim

# â”€â”€â”€ Auth.js â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with:
#   Linux/macOS: openssl rand -base64 32
#   Windows PowerShell: Add-Type -AssemblyName System.Web; [System.Web.Security.Membership]::GeneratePassword(32,0)
AUTH_SECRET=

# Cookie domain for cross-subdomain SSO
# Production: .asafarim.com
# Development: leave empty (defaults to localhost)
AUTH_COOKIE_DOMAIN=

# ─── Email Login Code (OTP) ───────────────────────────────────────────────────
# Duration a one-time login code is valid (minutes). Default: 10
EMAIL_LOGIN_CODE_TTL_MINUTES=10
# Max code requests per email per window before rate-limiting. Default: 5
EMAIL_CODE_MAX_REQUESTS=5
# Sliding window for request rate limit (minutes). Default: 15
EMAIL_CODE_REQUEST_WINDOW_MINUTES=15
# Max failed verify attempts per code before it is locked. Default: 5
EMAIL_CODE_MAX_ATTEMPTS=5

# â”€â”€â”€ Google OAuth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=***
AUTH_GOOGLE_SECRET=***
AUTH_GOOGLE_CALLBACK_URL=https://portal.asafarim.com/api/auth/callback/google

# Vionto — Google Photos import (separate incremental-OAuth grant, Photos scopes).
# See apps/vionto/.env.example and apps/vionto/docs/google-photos-import.md.
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=https://vionto.asafarim.com/api/integrations/google-photos/callback
GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/photospicker.mediaitems.readonly
# 32-byte AES-256-GCM key for encrypting stored OAuth tokens (openssl rand -hex 32).
VIONTO_TOKEN_ENCRYPTION_KEY=

# â”€â”€â”€ App URLs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORTAL_URL=https://portal.asafarim.com
# Client-visible portal URL used by cross-app navigation buttons.
# Local dev: http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=https://portal.asafarim.com
CONTENT_GENERATOR_URL=https://content-generator.asafarim.com
NEXT_PUBLIC_CONTENT_GENERATOR_URL=https://content-generator.asafarim.com
MARKETING_CONTENT_URL=https://marketing-content.asafarim.com
NEXT_PUBLIC_MARKETING_CONTENT_URL=https://marketing-content.asafarim.com
# Local dev override for portal redirect (/showcase/marketing-content)
LOCAL_MARKETING_CONTENT_URL=http://localhost:3004
OPS_HUB_URL=https://ops-hub.asafarim.com
NEXT_PUBLIC_OPS_HUB_URL=https://ops-hub.asafarim.com
VIONTO_URL=https://vionto.asafarim.com
NEXT_PUBLIC_VIONTO_URL=https://vionto.asafarim.com

# Optional SEO ownership verification codes.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# â”€â”€â”€ OpenAI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# â”€â”€â”€ Anthropic â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Vionto Production Integrations ───────────────────────────
REDIS_URL=redis://redis:6379
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=asafarim-vionto
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_PUBLIC_URL=https://asafarim-vionto.fra1.digitaloceanspaces.com
ELEVENLABS_API_KEY=sk____
WORKER_HEALTH_PORT=3007
# Use "local" for dev (files stored on disk), "spaces" for production (DigitalOcean)
VIONTO_STORAGE_DRIVER=local
# Required when local: absolute path accessible by both web app and worker
# VIONTO_LOCAL_STORAGE_DIR=/absolute/path/to/apps/vionto/.local-storage/uploads
