// ASafariM Digital — Prisma Schema
// Auth.js v5 required tables + full RBAC + CMS + admin panel

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Required Models ───────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  jobTitle      String?
  company       String?
  website       String?
  location      String?
  bio           String?   @db.Text

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  // Marketing attribution (captured at signup)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String? @db.Text
  landingPage String? @db.Text

  // Multi-tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // RBAC: many-to-many roles
  userRoles UserRole[]

  // Audit trail
  auditLogs AuditLog[]

  // Content generator
  contentFolders         ContentProjectFolder[]
  contentChatSessions    ContentChatSession[]
  savedPrompts           SavedPrompt[]
  contentGenerations     ContentGeneration[]
  contentTypeDefinitions ContentTypeDefinition[]

  // EduMatch
  eduStudentProfile      EduStudentProfile?
  eduTutorProfile        EduTutorProfile?
  eduInquiries           EduInquiry[]
  eduQuotes              EduQuote[]
  eduStudentBookings     EduBooking[]              @relation("EduBookingStudent")
  eduTutorBookings       EduBooking[]              @relation("EduBookingTutor")
  eduTransactions        EduTransaction[]
  eduWallet              EduWallet?
  eduNotifications       EduNotification[]
  eduMessages            EduMessage[]
  eduNotificationPrefs   EduNotificationPreference?
  eduTutorVerifications  EduTutorVerification[]    @relation("EduTutorVerificationTutor")
  eduTutorVerificationsReviewed EduTutorVerification[] @relation("EduTutorVerificationReviewer")
  eduAuditEventsActor    EduAuditEvent[]           @relation("EduAuditActor")

  // Vionto
  viontoProjects         ViontoProject[]
  viontoAuditEvents      ViontoAuditEvent[]        @relation("ViontoAuditActor")
  viontoUsageMetrics     ViontoUsageMetric[]
  viontoSharesSent       ViontoProjectShare[]      @relation("ViontoSharesSent")
  viontoSharesReceived   ViontoProjectShare[]      @relation("ViontoSharesReceived")

  // Generic user locations (home, work, etc.) - reusable across all apps
  locations UserLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([username])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * UserLocation - Reusable location model for any app.
 * Supports multiple locations per user (home, work, billing, etc.)
 */
model UserLocation {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("home") // home, work, billing, shipping, etc.
  label       String?  // Custom label (e.g., "My Apartment", "Parents' House")

  // Address components
  formatted   String?  // Full formatted address
  street1     String?
  street2     String?
  city        String?
  state       String?  // State/Province/Region
  postalCode  String?
  country     String?  // ISO 3166-1 alpha-2 (e.g., "US", "NL")
  countryName String?

  // Geolocation (Decimal degrees, WGS84)
  lat         Float?
  lng         Float?
  accuracy    Float?   // GPS accuracy in meters (if from browser)

  // Metadata
  timezone    String?  // IANA timezone (e.g., "Europe/Amsterdam")
  isPrimary   Boolean  @default(false) // Is this the user's primary location?
  isVerified  Boolean  @default(false) // Verified via geocoding?
  source      String   @default("manual") // manual, browser, geocoded, ip

  // App-specific scoping (optional - allows apps to have private locations)
  appScope    String[] @default([]) // e.g., ["edumatch", "portal"]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([lat, lng])
  @@index([country, city])
  @@unique([userId, type, label]) // Prevent duplicate labels per type
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Email One-Time Login Code ──────────────────────────────────

/// Short-lived 6-character OTP used for passwordless email-code login.
/// Codes are single-use and expire after EMAIL_LOGIN_CODE_TTL_MINUTES (default 10).
/// Rate limits: max 5 requests per email per 15 min; max 5 failed verify attempts.
model EmailLoginCode {
  id        String    @id @default(cuid())
  /// The email address the code was sent to (lowercased)
  email     String
  /// SHA-256 hex digest of the uppercased 6-character code
  codeHash  String
  /// When this code expires
  expiresAt DateTime
  /// Set when the code is successfully consumed
  usedAt    DateTime?
  /// Number of failed verification attempts against this code
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// ─── RBAC Models ───────────────────────────────────────────────

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String? @db.Text
  isSystem    Boolean @default(false)
  isDefault   Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isDefault])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String?
  group       String

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([group])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ─── CMS Models ────────────────────────────────────────────────

model SiteContent {
  id          String  @id @default(cuid())
  section     String  @unique
  title       String?
  subtitle    String?
  eyebrow     String?
  body        Json?
  metadata    Json?
  position    Int     @default(0)
  isPublished Boolean @default(true)
  updatedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@index([position])
  @@index([isPublished])
}

model NavItem {
  id                  String   @id @default(cuid())
  label               String
  labelKey            String?
  href                String
  position            Int      @default(0)
  visibility          String   @default("public")
  requiredRole        String?
  requiredPermissions String[] @default([])
  appScope            String[] @default(["all"])
  parentId            String?
  isActive            Boolean  @default(true)
  icon                String?
  target              String?  @default("_self")
  group               String   @default("main")
  placement           String   @default("header")
  metadata            Json?

  parent   NavItem?  @relation("NavItemTree", fields: [parentId], references: [id])
  children NavItem[] @relation("NavItemTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([position])
  @@index([visibility])
  @@index([parentId])
  @@index([placement])
  @@index([appScope])
}

model SiteSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  group       String  @default("general")
  displayName String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ─── Audit Log ─────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ─── Multi-Tenant Models ───────────────────────────────────────

model Tenant {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  plan             String    @default("free")
  status           String    @default("active") // active, trial, past_due, churned, suspended
  mrrCents         Int       @default(0)
  seats            Int       @default(1)
  region           String    @default("EU")
  industry         String?
  primaryContactId String?
  trialEndsAt      DateTime?
  churnedAt        DateTime?

  users            User[]
  subscriptions    Subscription[]
  featureOverrides FeatureFlagOverride[]
  lifecycleEvents  LifecycleEvent[]
  usageMetrics     UsageMetric[]

  // Content generator
  contentFolders         ContentProjectFolder[]
  contentChatSessions    ContentChatSession[]
  savedPrompts           SavedPrompt[]
  contentGenerations     ContentGeneration[]
  contentTypeDefinitions ContentTypeDefinition[]

  // Vionto
  viontoProjects      ViontoProject[]
  viontoUsageMetrics  ViontoUsageMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([plan])
}

// ─── SaaS Operations Hub ───────────────────────────────────────

model Plan {
  id         String  @id @default(cuid())
  code       String  @unique // free, starter, pro, enterprise
  name       String
  priceCents Int     @default(0)
  currency   String  @default("USD")
  interval   String  @default("month") // month, year
  seatLimit  Int?
  features   Json? // array of feature flag codes included
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Subscription {
  id          String    @id @default(cuid())
  tenantId    String
  planId      String
  status      String    @default("active") // active, trialing, past_due, canceled, paused
  startedAt   DateTime  @default(now())
  renewsAt    DateTime?
  canceledAt  DateTime?
  trialEndsAt DateTime?
  seats       Int       @default(1)
  mrrCents    Int       @default(0)
  externalId  String? // e.g. Stripe subscription id

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([planId])
}

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String
  number         String    @unique
  amountCents    Int
  currency       String    @default("USD")
  status         String    @default("paid") // paid, open, void, uncollectible, failed
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@index([issuedAt])
}

model FeatureFlag {
  id             String  @id @default(cuid())
  code           String  @unique // e.g. "advanced_analytics"
  name           String
  description    String? @db.Text
  category       String  @default("general") // general, beta, experimental, killswitch
  defaultEnabled Boolean @default(false)
  rolloutPercent Int     @default(0) // 0-100

  overrides FeatureFlagOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model FeatureFlagOverride {
  id       String  @id @default(cuid())
  flagId   String
  tenantId String
  enabled  Boolean
  note     String?

  flag   FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flagId, tenantId])
  @@index([tenantId])
}

model LifecycleEvent {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String // signup, activated, upgraded, downgraded, churn_risk, churned, recovered, expansion, support_ticket
  title      String
  details    String?  @db.Text
  severity   String   @default("info") // info, success, warning, danger
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([kind])
  @@index([occurredAt])
}

model UsageMetric {
  id          String   @id @default(cuid())
  tenantId    String
  metric      String // api_calls, active_users, storage_mb, seats_used
  value       Int
  periodStart DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([metric])
  @@index([periodStart])
}

// Vionto-specific usage metrics per tenant for quota enforcement and billing
model ViontoUsageMetric {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?
  projectId       String?
  metric          String // images_uploaded, storage_mb, tts_seconds, render_minutes, exports
  value           Int
  periodStart     DateTime
  periodEnd       DateTime?
  metadata        Json?

  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  project ViontoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
  @@index([userId])
  @@index([projectId])
  @@index([metric])
  @@index([periodStart])
}

// Vionto plan quotas - limits per plan code
model ViontoPlanQuota {
  id            String  @id @default(cuid())
  planCode      String  // vionto_free, vionto_pro, vionto_enterprise
  metric        String // images_per_month, storage_mb, tts_seconds_per_month, render_minutes_per_month, exports_per_month
  limitValue    Int
  overagePrice  Int? // price per unit over limit in cents
  currency      String  @default("USD")

  @@unique([planCode, metric])
  @@index([planCode])
  @@index([metric])
}

model Automation {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?   @db.Text
  trigger     String // schedule, event
  schedule    String? // cron expression
  eventType   String? // e.g. "tenant.churn_risk"
  action      String // notify, tag, email, run_webhook
  config      Json?
  isEnabled   Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?

  runs AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger])
  @@index([isEnabled])
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       String // success, failed, skipped
  output       String?   @db.Text
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
  @@index([startedAt])
}

// ─── App Registry & System Health ──────────────────────────────

model AppRegistry {
  id             String    @id @default(cuid())
  code           String    @unique // portal, content-generator, ops-hub, marketing-content
  name           String
  description    String?   @db.Text
  url            String // public URL (prod/qa subdomain)
  healthUrl      String // /api/health endpoint
  environment    String    @default("qa") // dev, qa, prod
  isEnabled      Boolean   @default(true)
  lastDeployedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  healthChecks HealthCheck[]

  @@index([environment])
  @@index([isEnabled])
}

model HealthCheck {
  id             String   @id @default(cuid())
  appId          String
  status         String // ok, degraded, down
  httpStatus     Int?
  responseTimeMs Int?
  error          String?  @db.Text
  checkedAt      DateTime @default(now())

  app AppRegistry @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([checkedAt])
  @@index([status])
}

// ─── Content Generator: Project / Chat / Prompt Persistence ────

model ContentProjectFolder {
  id          String  @id @default(cuid())
  userId      String
  tenantId    String?
  parentId    String?
  name        String
  description String? @db.Text
  color       String?
  icon        String?
  position    Int     @default(0)
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  parent   ContentProjectFolder?  @relation("ContentProjectFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ContentProjectFolder[] @relation("ContentProjectFolderTree")

  chatSessions ContentChatSession[]
  savedPrompts SavedPrompt[]
  generations  ContentGeneration[]

  @@index([userId])
  @@index([tenantId])
  @@index([parentId])
  @@index([isArchived])
}

model ContentChatSession {
  id            String    @id @default(cuid())
  userId        String
  tenantId      String?
  folderId      String?
  title         String
  contentType   String?
  status        String    @default("active")
  lastMessageAt DateTime?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  folder ContentProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  messages     ContentChatMessage[]
  savedPrompts SavedPrompt[]
  generations  ContentGeneration[]

  @@index([userId])
  @@index([tenantId])
  @@index([folderId])
  @@index([status])
  @@index([updatedAt])
}

model ContentChatMessage {
  id          String  @id @default(cuid())
  sessionId   String
  role        String // system, user, assistant
  content     String  @db.Text
  contentType String?
  provider    String?
  model       String?
  metadata    Json?

  createdAt DateTime @default(now())

  session ContentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SavedPrompt {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String?
  folderId     String?
  sessionId    String?
  title        String
  contentType  String
  prompt       String   @db.Text
  systemPrompt String?  @db.Text
  tags         String[]
  isFavorite   Boolean  @default(false)
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  folder  ContentProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  session ContentChatSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([folderId])
  @@index([sessionId])
  @@index([isFavorite])
}

model ContentTypeDefinition {
  id                 String   @id @default(cuid())
  slug               String
  label              String
  description        String?  @db.Text
  promptInstructions String?  @db.Text
  systemPrompt       String?  @db.Text
  isSystem           Boolean  @default(false)
  isActive           Boolean  @default(true)
  userId             String?
  tenantId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@unique([tenantId, slug])
  @@index([slug])
  @@index([userId])
  @@index([tenantId])
  @@index([isSystem])
  @@index([isActive])
}

model ContentGeneration {
  id               String  @id @default(cuid())
  userId           String
  tenantId         String?
  folderId         String?
  sessionId        String?
  contentType      String
  prompt           String  @db.Text
  output           String? @db.Text
  provider         String?
  model            String?
  status           String // succeeded, failed
  error            String? @db.Text
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  metadata         Json?

  createdAt DateTime @default(now())

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  folder  ContentProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  session ContentChatSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([folderId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

// ─── EduMatch Models ───────────────────────────────────────────
// AI-first homework help + tutor marketplace.
// See docs/edumatch-project-plan.md.
//
// Identity reuses the global `User` model. STUDENT vs TUTOR is implicit
// by the presence of EduStudentProfile / EduTutorProfile (a user may be
// both). ADMIN flows through the existing RBAC system.
//
// Geo fields temporarily use simple lat/lng Float columns (PostGIS not installed).
// TODO: Revert to PostGIS geography once PostGIS is available on the database.

model EduStudentProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  gradeLevel         String // K12, UNDERGRAD, GRAD
  subjectsOfInterest String[] @default([])
  homeAddress        Json?
  homeLat            Float?
  homeLng            Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeLevel])
}

model EduTutorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  bio             String? @db.Text
  subjectsTaught  String[] @default([])
  levelsTaught    String[] @default([])
  hourlyRateCents Int     @default(0)
  onlineOnly      Boolean @default(false)
  serviceRadiusKm Int     @default(10)
  homeAddress     Json?
  homeLat         Float?
  homeLng         Float?

  // Stripe Connect (Phase 4)
  stripeAccountId String? @unique
  payoutEnabled   Boolean @default(false)

  // Trust & quality
  verifiedAt  DateTime?
  ratingAvg   Float     @default(0)
  ratingCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onlineOnly])
  @@index([hourlyRateCents])
  @@index([ratingAvg])
  @@index([verifiedAt])
}

model EduInquiry {
  id          String  @id @default(cuid())
  studentId   String
  subject     String
  gradeLevel  String
  description String  @db.Text
  attachments Json? // [{ type, url, mime, sizeBytes }]
  aiSummary   String? @db.Text
  status      String  @default("NEW") // NEW, AI_RESPONDED, TUTOR_REQUESTED, BOOKED, CLOSED, REFUSED

  // Moderation snapshot taken at the time of inquiry/AI generation. Null until
  // a moderation decision has been made. Decisions are also logged on each
  // EduAiResponse so we keep history if the inquiry is re-asked.
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // CHEATING, EXAM_BYPASS, PLAGIARISM, UNSAFE_PERSONAL, OTHER, NONE
  moderationReason   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiResponses   EduAiResponse[]
  quoteRequests EduQuoteRequest[]

  @@index([studentId])
  @@index([status])
  @@index([subject])
  @@index([createdAt])
  @@index([moderationOutcome])
}

model EduAiResponse {
  id               String  @id @default(cuid())
  inquiryId        String
  modelUsed        String
  promptVersion    String
  explanation      String  @db.Text
  studyPlan        Json?
  practiceProblems Json?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  tokenCostMicros  Int? // 1/1,000,000 of a USD, integer math for billing
  latencyMs        Int?
  truncated        Boolean @default(false)
  stopReason       String?

  // Moderation snapshot for this specific generation attempt. ALLOW responses
  // contain regular AI output; REFUSE responses contain a redirection message.
  moderationOutcome  String? // ALLOW, REVIEW, REFUSE
  moderationCategory String? // CHEATING, EXAM_BYPASS, PLAGIARISM, UNSAFE_PERSONAL, OTHER, NONE
  moderationReason   String? @db.Text

  createdAt DateTime @default(now())

  inquiry EduInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
  @@index([moderationOutcome])
}

model EduQuoteRequest {
  id          String   @id @default(cuid())
  inquiryId   String
  studentId   String
  requestedAt DateTime @default(now())
  expiresAt   DateTime
  status      String   @default("OPEN") // OPEN, FULFILLED, EXPIRED, CANCELLED

  inquiry EduInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  quotes  EduQuote[]

  @@index([inquiryId])
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
}

model EduQuote {
  id                String  @id @default(cuid())
  quoteRequestId    String
  tutorId           String
  hourlyRateCents   Int
  estimatedHours    Float
  totalCents        Int
  currency          String  @default("eur")
  availabilitySlots Json? // [{ start, end, mode }]
  notes             String? @db.Text
  pdfUrl            String?
  status            String  @default("PENDING") // PENDING, SENT, ACCEPTED, DECLINED, EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteRequest EduQuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  tutor        User            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking      EduBooking?

  @@unique([quoteRequestId, tutorId])
  @@index([quoteRequestId])
  @@index([tutorId])
  @@index([status])
}

model EduBooking {
  id                    String    @id @default(cuid())
  quoteId               String    @unique
  studentId             String
  tutorId               String
  scheduledAt           DateTime
  durationMinutes       Int
  mode                  String // ONLINE, IN_PERSON
  meetingUrl            String?
  stripePaymentIntentId String?   @unique
  status                String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, DISPUTED
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote        EduQuote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  student      User             @relation("EduBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor        User             @relation("EduBookingTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  transactions EduTransaction[]
  messages     EduMessage[]

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
}

model EduTransaction {
  id               String  @id @default(cuid())
  bookingId        String
  tutorId          String
  type             String // CHARGE, REFUND, PAYOUT, PLATFORM_FEE
  grossCents       Int
  platformFeeCents Int     @default(0)
  netCents         Int
  currency         String  @default("EUR")
  stripeChargeId   String?
  stripePayoutId   String?

  createdAt DateTime @default(now())

  booking EduBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor   User       @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tutorId])
  @@index([type])
  @@index([createdAt])
  @@index([stripeChargeId])
}

model EduWallet {
  tutorId              String    @id
  balanceCents         Int       @default(0)
  pendingCents         Int       @default(0)
  payoutThresholdCents Int       @default(5000)
  currency             String    @default("EUR")
  lastPayoutAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model EduNotification {
  id      String    @id @default(cuid())
  userId  String
  type    String // INQUIRY_RECEIVED, AI_RESPONSE_READY, QUOTE_RECEIVED, BOOKING_CONFIRMED, PAYOUT_SENT, ...
  payload Json?
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

model EduMessage {
  id        String @id @default(cuid())
  bookingId String
  senderId  String
  body      String @db.Text

  createdAt DateTime @default(now())

  booking EduBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([senderId])
  @@index([createdAt])
}

// ─── EduMatch trust & safety ──────────────────────────────────────────────
//
// EduTutorProfile.verifiedAt remains the canonical "is verified now?" field.
// EduTutorVerification records the workflow around it: each review attempt,
// the checklist results, admin notes, and the resolution. The current row
// (latest by createdAt) holds the active workflow status; older rows preserve
// audit history. A tutor is verified when their profile has verifiedAt set,
// which is written by the admin verification routes when status -> VERIFIED.

model EduTutorVerification {
  id         String @id @default(cuid())
  tutorId    String
  reviewerId String?

  // Workflow status for this review iteration.
  status String @default("PENDING") // PENDING, NEEDS_CHANGES, VERIFIED, REJECTED

  // Optional structured checklist outcome.
  // Shape (free-form JSON): {
  //   identityVerified: boolean,
  //   credentialsVerified: boolean,
  //   backgroundCheck: boolean,
  //   profileComplete: boolean,
  //   notes?: string,
  // }
  checklist Json?

  // Free-form admin notes shown only to admins.
  adminNotes String? @db.Text

  // If status === NEEDS_CHANGES, this is the message shown to the tutor.
  tutorMessage String? @db.Text

  // When the review was resolved (VERIFIED, REJECTED, or NEEDS_CHANGES sent).
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor    User  @relation("EduTutorVerificationTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  reviewer User? @relation("EduTutorVerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tutorId])
  @@index([status])
  @@index([reviewerId])
  @@index([createdAt])
}

// User-level notification preferences for EduMatch domain events. Created
// lazily on first lookup; absence of a row means "all defaults" (everything
// in-app, email enabled where the dispatcher considers it safe).
model EduNotificationPreference {
  userId String @id

  // In-app delivery toggles.
  inAppInquiryReceived    Boolean @default(true)
  inAppAiResponseReady    Boolean @default(true)
  inAppQuoteReceived      Boolean @default(true)
  inAppBookingConfirmed   Boolean @default(true)
  inAppCancellationUpdate Boolean @default(true)
  inAppDisputeUpdate      Boolean @default(true)
  inAppPayoutSent         Boolean @default(true)

  // Email delivery toggles. Defaults are conservative — opt-in for marketing-
  // adjacent flows, opt-out for transactional safety flows.
  emailInquiryReceived    Boolean @default(true)
  emailAiResponseReady    Boolean @default(false)
  emailQuoteReceived      Boolean @default(true)
  emailBookingConfirmed   Boolean @default(true)
  emailCancellationUpdate Boolean @default(true)
  emailDisputeUpdate      Boolean @default(true)
  emailPayoutSent         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only audit trail for EduMatch state changes. Distinct from the
// generic AuditLog so EduMatch flows can record domain-specific transitions
// (prevState → nextState) without polluting the platform-wide log. The
// generic AuditLog remains in use elsewhere.
model EduAuditEvent {
  id         String  @id @default(cuid())
  actorId    String? // null for system events (e.g. webhook-driven payouts)
  actorRole  String? // STUDENT, TUTOR, ADMIN, SYSTEM
  action     String // INQUIRY_CREATED, AI_RESPONSE_GENERATED, AI_RESPONSE_REFUSED, ...
  entity     String // EduInquiry, EduAiResponse, EduQuote, EduBooking, EduTutorProfile, ...
  entityId   String?
  prevState  String?
  nextState  String?
  reason     String? @db.Text
  metadata   Json?

  createdAt DateTime @default(now())

  actor User? @relation("EduAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── Unified Shopping Cart ─────────────────────────────────────
// Shared cart/basket across all apps for unified checkout

model Cart {
  id              String     @id @default(cuid())
  userId          String
  status          String     @default("active") // active, checkout, completed, abandoned
  subtotalCents   Int        @default(0)
  totalCents      Int        @default(0)
  currency        String     @default("EUR")
  expiresAt       DateTime?
  checkoutSessionId String?
  paymentIntentId   String?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([checkoutSessionId])
}

model CartItem {
  id                 String  @id @default(cuid())
  cartId             String
  productType        String // edumatch_tutoring, edumatch_premium, content_generator, ops_hub_plan, other
  productId          String
  productName        String
  description        String?
  unitPriceCents     Int
  quantity           Int     @default(1)
  metadata           Json    @default("{}")
  sellerId           String? // For marketplace split payments (tutor's stripe account id, etc.)
  sellerType         String  @default("platform") // platform, tutor, external
  platformFeePercent Int     @default(15)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productType])
  @@index([productId])
  @@index([sellerId])
}

// ─── Vionto — Photo-to-Story Video Pipeline ──────────────────

model ViontoProject {
  id                   String   @id @default(cuid())
  userId               String
  tenantId             String?

  title                String
  description          String?  @db.Text

  // Story mode: narrative arc vs. simple slideshow
  mode                 String   @default("story") // story, slideshow, documentary

  // Story narrative mode: genre/style of narration
  storyMode            String?  @default("memory_film") // memory_film, travel_recap, family_archive, event_recap, social_reel, documentary

  // Emotional tone: feeling/mood of the narration
  emotionalTone        String?  @default("nostalgic") // nostalgic, joyful, calm, epic, funny, romantic, reflective

  // Visual style: render treatment for filters, captions, framing, and overlays
  visualStyle          String?  @default("clean_modern_slideshow") // film_grain, polaroid_memory, clean_modern_slideshow, travel_map_overlay, vhs_archive, wedding_cinematic, social_vertical_captions

  // Music selection: soundtrack direction for the video
  musicOption          String?  @default("no_music") // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId         String?  // Pixabay track ID if a specific track was selected
  musicUploadKey       String?  // Storage key for user-uploaded music
  musicMetadata        Json?    // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // Target locale for narration / captions
  locale               String   @default("en-US")

  // Lifecycle: draft -> ready -> rendering -> completed -> archived
  status               String   @default("draft") // draft, ready, rendering, completed, archived

  aspectRatio          String   @default("16:9") // 16:9, 9:16, 1:1, 4:3
  resolution           String?  // 720p, 1080p, 4k; null = auto
  targetDurationSeconds Int?    // User target; null = auto

  // Deletion/retention policy for this project
  retentionPolicy      String   @default("soft_delete") // soft_delete, hard_delete, archive

  // Relations
  assets       ViontoAsset[]
  scripts      ViontoScript[]
  audioTracks  ViontoAudioTrack[]
  renderJobs   ViontoRenderJob[]
  exports      ViontoExport[]
  usageMetrics ViontoUsageMetric[]

  // Ownership
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shares: who else can access this project
  shares       ViontoProjectShare[]

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ─── Vionto Project Sharing ──────────────────────────────────

model ViontoProjectShare {
  id               String  @id @default(cuid())
  projectId        String
  sharedByUserId   String
  // Null when the invitee is not yet registered
  sharedWithUserId String?
  // Email used for the invite (canonical, lowercase)
  email            String

  // Permission level: viewer can access, editor can rename/upload (future)
  permission       String  @default("viewer") // viewer, editor

  project        ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedBy       User          @relation("ViontoSharesSent",     fields: [sharedByUserId],   references: [id], onDelete: Cascade)
  sharedWith     User?         @relation("ViontoSharesReceived", fields: [sharedWithUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([projectId])
  @@index([sharedWithUserId])
  @@index([email])
}

model ViontoAsset {
  id                  String  @id @default(cuid())
  projectId           String
  userId              String

  // Asset classification
  type                String  @default("source_image") // source_image, thumbnail, extracted_frame, overlay

  // Display / storage URLs
  originalUrl         String?
  thumbnailUrl        String?
  storageKey          String? // S3 / object-store key for original
  thumbnailStorageKey String? // S3 / object-store key for thumbnail

  // Dimensions
  width               Int?
  height              Int?
  fileSizeBytes       Int?

  // Ordering within the project timeline
  orderIndex          Int     @default(0)

  // AI-generated caption for vision-aware story generation
  caption             String?  @db.Text
  captionProvider     String?  // openai, anthropic, google, manual
  captionModel        String?  // e.g. gpt-4o-mini, claude-3-haiku
  captionGeneratedAt  DateTime?

  // EXIF and technical metadata (JSON blob)
  metadata            Json?

  // Content safety moderation
  moderationOutcome   String? // ALLOW, REVIEW, REFUSE
  moderationCategory  String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason    String? @db.Text
  moderatedAt         DateTime?

  // Ownership
  project ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([type])
  @@index([orderIndex])
}

model ViontoScript {
  id              String  @id @default(cuid())
  projectId       String
  userId          String

  // Generation provenance
  promptVersion   String? // Which prompt template / version produced this
  provider        String? // openai, anthropic, custom, manual
  model           String? // e.g. gpt-4.1-mini, claude-haiku-4-5

  // Content
  narrationText   String? @db.Text // Plain-text narration
  srtText         String? @db.Text // SubRip subtitle text

  // Music selection for this script generation
  musicOption     String?  // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId    String?  // Pixabay track ID if a specific track was selected
  musicMetadata   Json?    // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // User override tracking
  isUserEdited    Boolean @default(false)

  // Audit / quality metadata
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?

  // Content safety moderation
  moderationOutcome   String? // ALLOW, REVIEW, REFUSE
  moderationCategory  String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason    String? @db.Text
  moderatedAt         DateTime?

  project ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([isUserEdited])
}

model ViontoAudioTrack {
  id              String  @id @default(cuid())
  projectId       String
  userId          String

  // Classification
  type            String  @default("narration") // narration, music, sfx
  source          String  @default("tts") // tts, upload, generated

  // Voice / instrument metadata
  voiceId         String?
  voiceName       String?

  // Duration in seconds
  durationSeconds Int?

  // Storage
  storageKey      String?

  // Mix settings: volume, fadeIn, fadeOut, startOffset (JSON)
  mixSettings     Json?

  // Content safety moderation
  moderationOutcome   String? // ALLOW, REVIEW, REFUSE
  moderationCategory  String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason    String? @db.Text
  moderatedAt         DateTime?

  project ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([type])
}

model ViontoRenderJob {
  id             String   @id @default(cuid())
  projectId      String
  userId         String

  // External queue / worker ID (e.g. BullMQ, Celery, etc.)
  queueId        String?

  // State machine
  state          String   @default("queued") // queued, running, paused, completed, failed, cancelled

  // Progress 0-100
  progressPercent Int     @default(0)

  // Worker logs (last N lines)
  logs           String?  @db.Text

  // Retry handling
  retryCount     Int      @default(0)
  errorSummary   String?  @db.Text

  // Timing
  startedAt      DateTime?
  completedAt    DateTime?

  // Relations
  project ViontoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exports ViontoExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([state])
  @@index([queueId])
  @@index([createdAt])
}

model ViontoExport {
  id              String  @id @default(cuid())
  projectId       String
  renderJobId     String?
  userId          String

  // Output storage
  storageKey      String

  // Technical metadata
  durationSeconds Int?
  fileSizeBytes   Int?
  format          String  @default("mp4") // mp4, mov, webm
  resolution      String? // 1080p, 4k, 720p
  filename        String?
  userMode        String? // cinematic, slideshow, social
  renderMode      String? // worker/render manifest mode
  aspectRatio     String? // 16:9, 9:16, 1:1
  aspectLabel     String? // landscape, portrait, 1by1
  visualStyle     String? // film_grain, polaroid_memory, clean_modern_slideshow, travel_map_overlay, vhs_archive, wedding_cinematic, social_vertical_captions
  storyKeywords   Json?
  previewTitle    String?
  previewSubtitle String? @db.Text

  // Music selection used for this export
  musicOption     String?  // calm_piano, cinematic_strings, travel_upbeat, family_warm_acoustic, no_music, upload_own
  musicTrackId    String?  // Pixabay track ID if a specific track was selected
  musicMetadata   Json?    // Track metadata (title, artist, duration, tags, downloadUrl, license, etc.)

  // Signed URL for direct download (time-limited)
  signedUrl       String?
  signedUrlExpiresAt DateTime?

  // Content safety moderation
  moderationOutcome   String? // ALLOW, REVIEW, REFUSE
  moderationCategory  String? // NSFW, VIOLENCE, HATE, OTHER, NONE
  moderationReason    String? @db.Text
  moderatedAt         DateTime?

  // Relations
  project    ViontoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderJob  ViontoRenderJob? @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([renderJobId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, userMode, createdAt])
  @@index([userId, aspectRatio, createdAt])
  @@index([format])
}

// Domain-specific audit trail for Vionto operations.
// Complements the generic AuditLog with render-pipeline transitions.
model ViontoAuditEvent {
  id         String  @id @default(cuid())
  actorId    String? // null for system / worker events
  actorRole  String? // CREATOR, ADMIN, SYSTEM, WORKER
  action     String // PROJECT_CREATED, ASSET_UPLOADED, SCRIPT_GENERATED, RENDER_STARTED, RENDER_COMPLETED, EXPORT_DOWNLOADED, ...
  entity     String // ViontoProject, ViontoAsset, ViontoScript, ViontoRenderJob, ViontoExport
  entityId   String?
  prevState  String?
  nextState  String?
  reason     String? @db.Text
  metadata   Json?

  createdAt DateTime @default(now())

  actor User? @relation("ViontoAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
