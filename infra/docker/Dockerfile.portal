FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@11.1.1

FROM base AS builder
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/portal ./apps/portal
COPY packages/auth ./packages/auth
COPY packages/db ./packages/db
COPY packages/location ./packages/location
COPY packages/ui ./packages/ui
COPY packages/shared-i18n ./packages/shared-i18n
COPY packages/country-language-selector ./packages/country-language-selector
COPY packages/types ./packages/types

RUN pnpm install --frozen-lockfile
# Explicitly generate Prisma client before building
RUN cd packages/db && npx prisma generate
RUN pnpm --filter @asafarim/db build
RUN pnpm --filter @asafarim/ui build
RUN pnpm --filter portal build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder
COPY --from=builder /repo/apps/portal/.next/standalone ./
COPY --from=builder /repo/apps/portal/.next/static ./.next/static
COPY --from=builder /repo/apps/portal/public ./public
COPY --from=builder /repo/packages/db ./packages/db
COPY --from=builder /repo/node_modules ./node_modules

# Regenerate Prisma client for Alpine (musl) runtime in production
RUN cd packages/db && npx prisma generate

# Fix ownership
RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
