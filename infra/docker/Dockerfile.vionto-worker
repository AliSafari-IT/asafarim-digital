FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Install FFmpeg and required system libs
RUN apk add --no-cache ffmpeg fontconfig ttf-liberation

FROM base AS builder
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/vionto ./apps/vionto
COPY packages/auth ./packages/auth
COPY packages/db ./packages/db
COPY packages/types ./packages/types
COPY packages/navigation ./packages/navigation
COPY packages/ui ./packages/ui
COPY packages/shared-i18n ./packages/shared-i18n

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @asafarim/db build
RUN pnpm --filter @asafarim/ui build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/packages/db ./packages/db
COPY --from=builder /repo/apps/vionto ./apps/vionto

# Regenerate Prisma client for Alpine (musl) runtime
RUN cd packages/db && npx prisma generate

# Copy Prisma client to expected location
RUN mkdir -p /app/node_modules/.prisma && \
    find /app/node_modules/.pnpm -type d -name ".prisma" -exec cp -r {}/client /app/node_modules/.prisma/ \; && \
    chown -R worker:nodejs /app/node_modules/.prisma

USER worker

# The worker entry point
CMD ["npx", "tsx", "apps/vionto/worker.ts"]
