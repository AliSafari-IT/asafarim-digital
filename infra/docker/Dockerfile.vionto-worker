FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# FFmpeg + font libs required by the render pipeline
RUN apk add --no-cache ffmpeg fontconfig ttf-liberation

# ─── Builder ──────────────────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/vionto ./apps/vionto
COPY packages/auth ./packages/auth
COPY packages/db ./packages/db
COPY packages/types ./packages/types
COPY packages/ui ./packages/ui
COPY packages/country-language-selector ./packages/country-language-selector
COPY packages/shared-i18n ./packages/shared-i18n
COPY packages/vionto-schemas ./packages/vionto-schemas

# Full install so tsup can resolve all imports while bundling
RUN pnpm install --no-frozen-lockfile --filter vionto... --filter @asafarim/db... --prefer-offline

# Generate Prisma client for the builder arch (needed so @asafarim/db can build)
RUN cd packages/db && npx prisma generate
RUN pnpm --filter @asafarim/db build
RUN pnpm --filter @asafarim/ui build

# Bundle worker.ts using the package.json script which has all correct --external flags
RUN pnpm --filter vionto run worker:build

# ─── Runner ───────────────────────────────────────────────────────────────────
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

# Copy @asafarim/db source files (it's source-only, no dist output).
# tsup bundles it inline (noExternal config), so source must be available.
COPY --from=builder /repo/packages/db/src ./node_modules/@asafarim/db/src
COPY --from=builder /repo/packages/db/package.json ./node_modules/@asafarim/db/package.json
COPY --from=builder /repo/packages/db/prisma ./prisma

# Install all external runtime deps and regenerate Prisma for Alpine (musl)
RUN npm install \
      @prisma/client@6.19.3 prisma@6.19.3 \
      bullmq ioredis openai \
      @aws-sdk/client-s3 @aws-sdk/s3-request-presigner && \
    npx prisma generate --schema=prisma/schema.prisma

# The fully self-contained worker bundle
COPY --from=builder /repo/apps/vionto/worker-dist ./worker-dist

RUN chown -R worker:nodejs /app
USER worker

# Plain node -- no tsx, no npx download, no symlink resolution
CMD ["node", "worker-dist/worker.js"]
