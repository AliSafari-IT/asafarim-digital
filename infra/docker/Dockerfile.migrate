# Lightweight container that runs Prisma migrations on startup.
# Used as a one-shot init container in docker-compose.
FROM node:22-alpine

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@11.1.1

WORKDIR /app

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/db/package.json ./packages/db/package.json
COPY packages/db/prisma/ ./packages/db/prisma/
COPY packages/db/prisma/migrations/ ./packages/db/prisma/migrations/

WORKDIR /app

RUN pnpm install --ignore-scripts --filter @asafarim/db

WORKDIR /app/packages/db

CMD ["sh", "-c", "npx prisma generate --schema=./prisma/schema.prisma && npx prisma migrate deploy --schema=./prisma/schema.prisma"]
